<?xml version="1.0" encoding="utf-8"?>
<!--
  Config for DoomscrollAccessibilityService. We only listen for window-state
  changes (which app is in front) and never retrieve window CONTENT — the app
  reads no on-screen text, only the foreground package name.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="false"
    android:description="@string/doomscroll_accessibility_desc"
    android:summary="@string/doomscroll_accessibility_summary" />
